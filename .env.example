# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model tier configuration (override defaults)
CONCORD_MODEL_FAST=claude-haiku-4-5-20251001
CONCORD_MODEL_STANDARD=claude-sonnet-4-6
CONCORD_MODEL_HIGH=claude-opus-4-7

# Budget controls
CONCORD_MAX_TOKENS_PER_REQUEST=8000
CONCORD_MAX_TURNS=8
CONCORD_MAX_CLARIFICATIONS=2

# State store
CONCORD_DB_URL=sqlite+aiosqlite:///./concord.db

# Vector store
CONCORD_CHROMA_PATH=./.chroma

# Server
CONCORD_HOST=0.0.0.0
CONCORD_PORT=8080
CONCORD_LOG_LEVEL=INFO
CONCORD_ENV=development

# Confidence thresholds
CONCORD_CONFIDENCE_ESCALATE=0.55
CONCORD_CONFIDENCE_AUTO_ACTION=0.80

# Feature flags
CONCORD_VERIFICATION_ENABLED=true
CONCORD_PII_REDACTION_ENABLED=true
